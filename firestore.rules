rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cada household tem o uid do dono como id do documento. Qualquer
    // usuário autenticado pode ler (precisa, para validar um código de
    // convite antes de entrar) — só o dono pode escrever livremente; quem
    // não é membro só pode escrever para se ADICIONAR à lista de membros
    // (entrar com um código de convite), nunca para remover outros.
    match /households/{ownerUid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == ownerUid
        && request.resource.data.memberUids == [ownerUid];
      allow update: if request.auth != null && (
        request.auth.uid == ownerUid ||
        (request.auth.uid in request.resource.data.memberUids
          && !(request.auth.uid in resource.data.memberUids))
      );
    }

    // Os dados continuam guardados sob o uid de quem criou o household
    // (dono). Isso permite que, quando o usuário entra num household
    // compartilhado, os dados acessados sejam os do dono — sem precisar
    // migrar nenhuma coleção existente.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId ||
        (exists(/databases/$(database)/documents/households/$(userId))
          && request.auth.uid in get(/databases/$(database)/documents/households/$(userId)).data.memberUids)
      );
    }
  }
}
